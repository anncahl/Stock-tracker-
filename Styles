:root{
--bg-color:#F3F4F6;
--card-bg:#ffffff;
--primary-color:#1e3a8a;
--accent-color:#10b981;
--text-color:#1F2937;
--border-color:#e5e7eb;
}
body{
font-family:'Roboto',sans-serif;
background-color:var(--bg-color);
color:var(--text-color);
}
h1,h2,h3{
font-family:'Montserrat',sans-serif;
color:var(--primary-color);
}
button{
font-family:'Roboto',sans-serif;
background-color:var(--accent-color);
color:#ffffff;
border:none;
}
tables{
width:100%
border-collapse:collapse:
margin-top:15px;
}
th,td{
border:1px solid #ccc;
padding:10px;
text-align:left;
}
th{
background-color:#2c3e50;
color:#ffffff;
}
tbody tr:nth-child(even){
background-color:#f2f2f2;
}
form,add-expense-section{
background-color:var(--card-bg);
padding:20px;
border:1px solid var(--border-color);
border-radius:8px;
margin-bottom:25px;
}
input[type="text"],
input[type="number"],
input[type="date"],
{
font-family:'Roboto',sans-serif;
width:100%;
padding:10px,
margin-top:15px;
margin-bottom:15px;
border:1px solid #ccc;
border-radius:5px;
box-sizing:border-box;
}
label{
font-family:'Roboto',sans-serif;
font-weight:500;
}
button{
padding:10px 18px;
border-radius:5px;
cursor:pointer;
}
{box-sizing:border-box;
}
body{
max-width:900px;
margin:0 auto;
padding:20px;
}
header,add-expense section,expense section{
background-color:var(--card-bg);
padding:20px;
margin-bottom:25px;
border:1px solid var(--border-color);
border-radius:8px;
}
